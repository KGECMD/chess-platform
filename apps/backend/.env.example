NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chess
# REDIS_URL is optional — if unset, matchmaking falls back to an in-memory queue.
# REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
STOCKFISH_PATH=/usr/games/stockfish
CORS_ORIGIN=http://localhost:3000

# Auto-match solo queuers to Stockfish after this many milliseconds
# (set to 0 to disable and only ever pair humans).
BOT_FALLBACK_MS=15000
# Stockfish skill level (0–20) used for bot fallbacks.
BOT_FALLBACK_LEVEL=6
